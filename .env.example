# Spring Application Name
SPRING_APPLICATION_NAME=verivote-service-server

# Logging level configuration
LOGGING_LEVEL_SPRING_FRAMEWORK=info
LOGGING_LEVEL_INTERNAL_STATUS=info
LOGGING_LEVEL_SPRING_SECURITY=info
LOGGING_LEVEL_HIBERNATE_SQL=info

# Web Client Layer
WEB_CLIENT_API_ROOT=/api
WEB_CLIENT_API_VERSION=/v1
WEB_CLIENT_API_USER_ROOT=/user
WEB_CLIENT_API_VOTE_ROOT=/vote
WEB_CLIENT_API_QUERY_ROOT=/query

# Command Api
COMMAND_API_ROOT=/api
COMMAND_API_PLACEHOLDER=/command

# Blockchain Node Layer
BLOCKCHAIN_NODE_UNICAST_ROOT=/unicast
BLOCKCHAIN_NODE_UNICAST_NOTIFICATION_ROOT=/notification

# Blockchain Node Server Connections (gRPC)
# Hosts are Docker Compose service names. Use 127.0.0.1 when running outside Docker.
GRPC_SERVER_BLOCKCHAIN_HOST=blockchain-node
GRPC_SERVER_BLOCKCHAIN_PROPOSAL_PORT=9000
GRPC_SERVER_BLOCKCHAIN_SUBMIT_PORT=9001
GRPC_SERVER_BLOCKCHAIN_COMMAND_PORT=9010

# MongoDB Cache Server Connections (gRPC)
GRPC_SERVER_CACHE_HOST=caching-server
GRPC_SERVER_CACHE_PORT=50051

# Open API Swagger Configuration
SPRINGDOC_DOCUMENT_ROOT=/documents
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/api
SPRINGDOC_PATHS_TO_EXCLUDE=/unicast/**
SPRINGDOC_SWAGGER_UI_TRY_IT_OUT_ENABLED=true
SPRINGDOC_SWAGGER_UI_FILTER=false

# JPA & Hibernate Configuration
SPRING_JPA_HIBERNAME_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
SPRING_JPA_FORMATTING_SQL=false

# MariaDB / MySQL Datasource Configuration
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver
SPRING_DATASOURCE_JDBC=jdbc
SPRING_DATASOURCE_ENGINE=mariadb
SPRING_DATASOURCE_HOST=mariadb
SPRING_DATASOURCE_PORT=3306
SPRING_DATASOURCE_DATABASE=voting_db
SPRING_DATASOURCE_USERNAME=verivote
SPRING_DATASOURCE_PASSWORD=verivote

# Spring security & JWT Configuration
SPRING_SECURITY_USERNAME_PARAMETER_PROPERTY=username
SPRING_SECURITY_PASSWORD_PARAMETER_PROPERTY=password
# Demo key for local runs only. Replace before deploying anywhere reachable.
# Must be at least 32 bytes for HS256. Generate with: openssl rand -base64 48
SPRING_SECURITY_JWT_SECRET_KEY=bG9jYWxEZW1vT25seVJlcGxhY2VNZUJlZm9yZURlcGxveWluZzEyMzQ1Ng==
SPRING_SECURITY_JWT_ACCESS_EXPIRE_DELTA=3600
SPRING_SECURITY_JWT_REFRESH_EXPIRE_DELTA=86400

# Gmail SMTP Server & IMAP Configuration
GMAIL_SPRING_HOST=smtp.gmail.com
GMAIL_SPRING_PORT=587
GMAIL_SPRING_USERNAME=
# Gmail App Password (16 chars, requires 2FA). A normal account password will not work.
GMAIL_SPRING_PASSWORD=
GMAIL_SPRING_SMTP_AUTH=true
GMAIL_SPRING_SMTP_START_TLS_ENABLE=true
GMAIL_SPRING_SMTP_DEBUG=true
GMAIL_SPRING_SMTP_CONNECTION_TIMEOUT=10000

# Gmail verification code digest
GMAIL_VERIFICATION_DIGEST=ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890
GMAIL_VERIFICATION_LENGTH=6
GMAIL_VERIFICATION_EXP_DELTA=5
