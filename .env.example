# Spring Application Name
SPRING_APPLICATION_NAME="Your server name"

# Logging level configuration
LOGGING_LEVEL_SPRING_FRAMEWORK=info  # Customize log level
LOGGING_LEVEL_INTERNAL_STATUS=info   # Customize log level
LOGGING_LEVEL_SPRING_SECURITY=info   # Customize log level
LOGGING_LEVEL_HIBERNATE_SQL=info     # Customize log level

# Web Client Layer
WEB_CLIENT_API_ROOT=/api           # DO NOT EDIT
WEB_CLIENT_API_VERSION=/v1         # DO NOT EDIT
WEB_CLIENT_API_USER_ROOT=/user     # DO NOT EDIT
WEB_CLIENT_API_VOTE_ROOT=/vote     # DO NOT EDIT
WEB_CLIENT_API_QUERY_ROOT=/query   # DO NOT EDIT

# Command Api
COMMAND_API_ROOT=/api            # DO NOT EDIT
COMMAND_API_PLACEHOLDER=/command # DO NOT EDIT

# Blockchain Node Layer
BLOCKCHAIN_NODE_UNICAST_ROOT=/unicast                    # DO NOT EDIT
BLOCKCHAIN_NODE_UNICAST_NOTIFICATION_ROOT=/notification  # DO NOT EDIT

# Blockchain Node Server Connections (gRPC)
GRPC_SERVER_BLOCKCHAIN_HOST="Blockchain node ip address"
GRPC_SERVER_BLOCKCHAIN_PROPOSAL_PORT=9000  # DO NOT EDIT
GRPC_SERVER_BLOCKCHAIN_SUBMIT_PORT=9001    # DO NOT EDIT
GRPC_SERVER_BLOCKCHAIN_COMMAND_PORT=9010   # DO NOT EDIT

# MongoDB Cache Server Connections (gRPC)
GRPC_SERVER_CACHE_HOST="Blockchain node ip address"
GRPC_SERVER_CACHE_PORT=50051    # DO NOT EDIT

# Open API Swagger Configuration
SPRINGDOC_DOCUMENT_ROOT=/documents          # DO NOT EDIT
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html  # DO NOT EDIT

#SPRINGDOC_DOCUMENT_ROOT=/documents                    # DO NOT EDIT
#SPRINGDOC_SWAGGER_UI_PATH=/documents/swagger-ui.html  # DO NOT EDIT
#SPRINGDOC_API_DOCS_PATH=/documents/v3/api-docs        # DO NOT EDIT

SPRINGDOC_API_DOCS_PATH=/api                 # DO NOT EDIT
SPRINGDOC_PATHS_TO_EXCLUDE=/unicast/**       # DO NOT EDIT
SPRINGDOC_SWAGGER_UI_TRY_IT_OUT_ENABLED=true # DO NOT EDIT
SPRINGDOC_SWAGGER_UI_FILTER=false            # DO NOT EDIT

# JPA & Hibername Configuration
SPRING_JPA_HIBERNAME_DDL_AUTO=update                                 # DO NOT EDIT
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect    # DO NOT EDIT
SPRING_JPA_FORMATTING_SQL=false                                      # DO NOT EDIT

# MariaDB / MySQL Datasource Configuration
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver # DO NOT EDIT
SPRING_DATASOURCE_JDBC=jdbc                                 # DO NOT EDIT
SPRING_DATASOURCE_ENGINE=mariadb                            # DO NOT EDIT
SPRING_DATASOURCE_HOST=127.0.0.1                            # DO NOT EDIT
SPRING_DATASOURCE_PORT="Your DB connection port"
SPRING_DATASOURCE_DATABASE="Your db name"
SPRING_DATASOURCE_USERNAME="Your db username"
SPRING_DATASOURCE_PASSWORD="Your db password"

# Spring security & JWT Configuration
SPRING_SECURITY_USERNAME_PARAMETER_PROPERTY=username    # DO NOT EDIT
SPRING_SECURITY_PASSWORD_PARAMETER_PROPERTY=password    # DO NOT EDIT
SPRING_SECURITY_JWT_SECRET_KEY="JWT KEY"
SPRING_SECURITY_JWT_ACCESS_EXPIRE_DELTA=3600    # 1 Hour
SPRING_SECURITY_JWT_REFRESH_EXPIRE_DELTA=86400  # 1 Day

# Gmail SMTP Server & IMAP Configuration
GMAIL_SPRING_HOST=
GMAIL_SPRING_PORT=
GMAIL_SPRING_USERNAME=
GMAIL_SPRING_PASSWORD=
GMAIL_SPRING_SMTP_AUTH=true
GMAIL_SPRING_SMTP_START_TLS_ENABLE=true
GMAIL_SPRING_SMTP_DEBUG=true
GMAIL_SPRING_SMTP_CONNECTION_TIMEOUT=1000

# Gmail verification code digest
GMAIL_VERIFICATION_DIGEST=
GMAIL_VERIFICATION_LENGTH=6
GMAIL_VERIFICATION_EXP_DELTA=5